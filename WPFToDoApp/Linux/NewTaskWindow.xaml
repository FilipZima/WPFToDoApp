<Window x:Class="WPFToDoApp.Linux.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFToDoApp.Linux"
        mc:Ignorable="d"
        Title="New Task" Height="150" Width="150">
    <Grid Background="AliceBlue">
        <Label Content="Title:&#xD;&#xA;" HorizontalAlignment="Left" Margin="0,22,0,0" VerticalAlignment="Top" Height="23"/>
        <TextBox x:Name="CreateTextBox" HorizontalAlignment="Left" Margin="34,27,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="111"/>
        <CheckBox x:Name="CreateCheckBox" Content="Is Done" HorizontalAlignment="Left" Margin="10,55,0,0" VerticalAlignment="Top"/>
        
        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,20,20" VerticalAlignment="Bottom" Click="CancelClick" Background="White"/>
        <Button Content="Submit" HorizontalAlignment="Left" Margin="20,0,0,20" VerticalAlignment="Bottom" Click="SubmitClick" Background="White"/>
    </Grid>
</Window>
