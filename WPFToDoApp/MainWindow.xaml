<Window x:Class="WPFToDoApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFToDoApp"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="To Do App" Height="450" Width="284">

    <Grid Background="AliceBlue">
        <ListBox x:Name="TodoListBox" Width="250" Background="LightBlue" Margin="17,17,17,118">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Title}"/>
                        <CheckBox IsChecked="{Binding IsDone}" DataContext="{Binding ID}" Checked="CheckboxChecked"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="AddButton" Content="+" HorizontalAlignment="Right" Width="32px" Height="32px" Margin="0,0,20,20" VerticalAlignment="Bottom" Background="LightBlue" Foreground="White" FontSize="24"/>
        <Button x:Name="RemoveButton" Content="-" HorizontalAlignment="Right" Width="32px" Height="32px" Margin="0,0,20,60" VerticalAlignment="Bottom" Background="LightBlue" Foreground="White" FontSize="24"/>
        <Button x:Name="EditButton" Content="E" HorizontalAlignment="Right" Width="32px" Height="32px" Margin="0,0,69,20" VerticalAlignment="Bottom" Background="LightBlue" Foreground="White" FontSize="24"/>
    </Grid>
</Window>