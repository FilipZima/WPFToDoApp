<Window x:Class="WPFToDoApp.Linux.NewTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFToDoApp.Linux"
        mc:Ignorable="d"
        Title="New Task" Height="256" Width="256">
    <Grid Background="AliceBlue">
        <Label Content="Title:&#xD;&#xA;" HorizontalAlignment="Left" Margin="10,57,0,0" VerticalAlignment="Top" Height="33" Width="41"/>
        <TextBox x:Name="CreateTextBox" HorizontalAlignment="Left" Margin="49,57,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="188" Height="26"/>
        <CheckBox x:Name="CreateCheckBox" Content="Is Done" HorizontalAlignment="Left" Margin="20,120,0,0" VerticalAlignment="Top" Height="32" Width="105"/>

        <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,0,20,20" VerticalAlignment="Bottom" Click="CancelClick" Background="White" Height="35" Width="87"/>
        <Button Content="Submit" HorizontalAlignment="Left" Margin="20,0,0,20" VerticalAlignment="Bottom" Click="SubmitClick" Background="White" Height="35" Width="82"/>
    </Grid>
</Window>
