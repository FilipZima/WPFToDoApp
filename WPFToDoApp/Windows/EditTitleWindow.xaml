<Window x:Class="WPFToDoApp.Windows.EditTitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFToDoApp.Windows"
        mc:Ignorable="d"
        Title="EditTitleWindow" Height="90" Width="154">
    <Grid>
        <Button Content="Edit" HorizontalAlignment="Left" Margin="41,50,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.249,0.428" Click="SubmitClick"/>
        <TextBox x:Name="EditTextBox" HorizontalAlignment="Center" Margin="0,19,0,0" TextWrapping="Wrap" Text="New Title" VerticalAlignment="Top" Width="120"/>
        <Button Content="Cancer" HorizontalAlignment="Left" Margin="84,50,0,0" VerticalAlignment="Top" Click="CancelClick"/>
    </Grid>
</Window>
